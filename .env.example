# Database
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Auth
AUTH_SECRET=generate-with-openssl-rand-base64-32
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Paystack — use TEST keys (sk_test_..., pk_test_...) until you've run
# through the full acceptance test, then switch to LIVE keys for production.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx

# ── File storage ────────────────────────────────────────────────────
# "local" (default) = ./private-storage on disk. DEV ONLY — do not use on
#   serverless platforms (Vercel), whose filesystem is ephemeral.
# "s3" = any S3-compatible object store (AWS S3, Cloudflare R2, Backblaze
#   B2, DigitalOcean Spaces, Supabase Storage). REQUIRED for production /
#   serverless deployment.
STORAGE_DRIVER=local

# Only used when STORAGE_DRIVER=local:
PRIVATE_STORAGE_DIR=./private-storage

# Only used when STORAGE_DRIVER=s3:
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Set S3_ENDPOINT for R2/B2/Spaces (leave blank for real AWS S3), e.g.:
#   Cloudflare R2:  https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
# Set to "true" only for providers that require path-style URLs (some
# MinIO/self-hosted setups). Leave unset/false for AWS S3 and R2.
S3_FORCE_PATH_STYLE=false

# Signs short-lived e-book/lesson access tokens (local driver only).
# Falls back to AUTH_SECRET if unset — fine to leave blank, but set
# independently if you want to rotate one without rotating the other.
FILE_SIGNING_SECRET=

# ── Rate limiting ───────────────────────────────────────────────────
# Optional. Without these, rate limiting falls back to an in-memory store
# — correct for a single-instance deploy (one Railway/Render/Fly
# container), but NOT shared across multiple serverless instances
# (Vercel). For that setup, create a free Upstash Redis database and set:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# First admin account — read by `npm run seed`. Leave unset to skip
# creating an admin during seeding (see README: "Creating the first admin").
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Email (optional) — wire your provider into lib/email.ts; the app
# functions fine with this unset, emails are just skipped.
RESEND_API_KEY=
